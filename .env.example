# Copy to .env and fill in. Never commit .env.

# Knowledge OS has no AI of its own. Your agents (Hermes, Claude, ChatGPT…) connect over MCP.

# --- Semantic search -------------------------------------------------------------------
# local = small model on the server, no API, no cost (default) · none = keyword search only
KOS_EMBEDDINGS=local

# --- Memory ------------------------------------------------------------------------------
# KOS_BRIEF_TOKEN_BUDGET=2000       # size of the session-start brief agents get
# KOS_CORE_MEMORY_MAX_CHARS=4000    # Profile and Rules each; agents only read this much
# KOS_MEMORY_STALE_DAYS=180         # flag facts not updated for this long in Tidy-up

# --- MCP (agents) ----------------------------------------------------------------------
# Public URL agents use to reach the MCP server (used for OAuth metadata). Include the scheme.
KOS_MCP_PUBLIC_BASE=https://mcp.example.com
# Extra host names allowed to reach the MCP server (comma separated)
# KOS_MCP_ALLOWED_HOSTS=
# Legacy static tokens from v1 still work. Prefer per-agent tokens created in the UI.
# MCP_AUTH_TOKEN=
# KOS_MCP_WRITE_TOKEN_NAME=Hermes  # who MCP_AUTH_TOKEN belongs to (provenance + Agents/<name>/)
# MCP_READ_TOKEN=
# KOS_MCP_WRITE_RATE_PER_MIN=120

# --- Web sign-in -----------------------------------------------------------------------
# Set the password with:  docker compose exec knowledge-os python -m knowledge_os set-password
# (v1 KNOWLEDGE_OS_GATE_HASH / KNOWLEDGE_OS_GATE_SALT are still honoured until you do.)
# KOS_COOKIE_SECURE=auto      # auto = secure cookie whenever the request came over HTTPS
# KOS_SESSION_DAYS=7

# --- Docker host settings ----------------------------------------------------------------
# KOS_BIND=127.0.0.1          # set to 0.0.0.0 only if you reach it by IP without a proxy
# KOS_DATA_HOST_DIR=./data    # e.g. /root/personal-ai-knowledge-os/data to reuse v1 data
# KOS_WEB_PORT_HOST=8786
# KOS_MCP_PORT_HOST=8796

# --- Housekeeping ------------------------------------------------------------------------
# KOS_BACKUP_INTERVAL_HOURS=24
# KOS_BACKUP_KEEP=14
# KOS_RECONCILE_INTERVAL=30   # seconds between scans for edits made outside the app
# KOS_MAX_UPLOAD_MB=25
